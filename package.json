{
  "name": "garlick-endgames",
  "private": true,
  "version": "0.1.0",
  "description": "Endgame drill trainer with tablebase-graded moves, family accounts and a daily Garlick bulb.",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:server": "node --watch server/index.js",
    "dev:client": "vite --config client/vite.config.ts",
    "build": "vite build --config client/vite.config.ts",
    "start": "node server/index.js",
    "test": "vitest run",
    "typecheck": "tsc -p client/tsconfig.json --noEmit",
    "puzzles": "node scripts/generate-puzzles.mjs"
  },
  "dependencies": {
    "chess.js": "^1.4.0",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vitest": "^2.1.8"
  }
}
